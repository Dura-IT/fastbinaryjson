<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!--
      Nullable is on project-wide, per house convention. The single exception is Tests.cs, which
      carries a file-scoped '#nullable disable': it is 1,790 lines of 2010-era, nullable-oblivious
      ported source, and annotating it belongs to the restyle commit rather than here. Scoping the
      exception to that one file keeps every new file in this project nullable-checked.
    -->
    <Nullable>enable</Nullable>
    <!--
      Golden wire-format fixtures embed AssemblyQualifiedNames, so three separate identities are
      baked into the committed bytes and all three are part of the format contract:

        1. This assembly's NAME and VERSION, for every fixture type. Pinned below.
        2. TargetFramework, for the typed-array fixtures. int-array-typed, string-array-typed and
           string-array-typed-v14 carry the element type's AQN, which on .NET resolves to
           'System.Private.CoreLib, Version=10.0.0.0'. Bumping the TFM rewrites those three files.
           MSBuild cannot pin that, so GoldenFileTests asserts the runtime version instead and
           fails with an explicit message rather than three unexplained byte diffs.
        3. Reflection member order per fixture type, which is why GoldenCorpus.cs says that
           reordering a property is a format change.
    -->
    <AssemblyName>FastBinaryJson.UnitTests</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\fastBinaryJSONcore\fastBinaryJSON.csproj" />
  </ItemGroup>

</Project>
