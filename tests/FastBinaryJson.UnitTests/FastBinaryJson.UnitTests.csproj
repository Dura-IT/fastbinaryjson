<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!--
      Nullable stays off for the mechanical port only. Tests.cs is 2010-era, nullable-oblivious
      source; enabling it here would mean rewriting test bodies in the same commit that changes
      the assertion framework, making any red test impossible to attribute. Re-enabled by the
      follow-up commit that restyles this suite to house conventions.
    -->
    <Nullable>disable</Nullable>
    <!--
      Golden wire-format fixtures embed each fixture type's AssemblyQualifiedName, which carries
      this assembly's name and version. Both are pinned so that a routine version bump does not
      silently invalidate every committed fixture. Changing either requires regenerating them.
    -->
    <AssemblyName>FastBinaryJson.UnitTests</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\fastBinaryJSONcore\fastBinaryJSON.csproj" />
  </ItemGroup>

</Project>
