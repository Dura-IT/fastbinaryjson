<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>FastBinaryJson.Benchmarks</RootNamespace>
    <AssemblyName>FastBinaryJson.Benchmarks</AssemblyName>
    <!-- BenchmarkDotNet requires Release; guard against an accidental Debug run producing nonsense. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\fastBinaryJSONcore\fastBinaryJSON.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
  </ItemGroup>

</Project>
