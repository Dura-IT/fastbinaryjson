<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>FastBinaryJson.Benchmarks</RootNamespace>
    <AssemblyName>FastBinaryJson.Benchmarks</AssemblyName>
    <!-- BenchmarkDotNet requires Release; guard against an accidental Debug run producing nonsense. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The same project is measured on .NET Framework, where the library's netstandard2.0 asset is used. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Remove="IsExternalInit.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FastBinaryJson\FastBinaryJson.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="MessagePack" Version="3.1.11" />
    <!--
      Upstream's last release, pinned on purpose: it is what the fork is measured against. Its
      assembly (fastbinaryjson) and namespace (fastBinaryJSON) differ from the fork's, so both load
      side by side in one process without an extern alias.
    -->
    <PackageReference Include="fastBinaryJSON" Version="1.6.1" />
  </ItemGroup>
</Project>
