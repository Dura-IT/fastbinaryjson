<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Public members must be documented: with this on, CS1591 fails the build for any that are not. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      LangVersion must be explicit. The SDK picks it per TFM, and netstandard2.0 defaults to C# 7.3,
      which does not have nullable reference types at all - '<Nullable>enable</Nullable>' fails that
      target outright with 'error CS8630: Invalid nullable value: Enable for C# 7.3'. Pinning it here
      is also what lets modern C# be written once for both targets instead of twice.
    -->
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>

    <!--
      AssemblyName must stay different from upstream's 'fastBinaryJSON'; the project name alone
      is not enough, since 'FastBinaryJson' differs from it by case only. Since the namespace
      rename the namespaces differ too, so referencing this package alongside Mehdi Gholam's
      original no longer produces duplicate type definitions at all.
    -->
    <AssemblyName>DuraIT.FastBinaryJson</AssemblyName>
    <PackageId>DuraIT.FastBinaryJson</PackageId>
    <!--
      Namespace matches assembly and package. It was 'fastBinaryJSON' until 2026-09-28, kept
      there as a claimed drop-in guarantee; that reasoning does not hold - $type carries the
      CONSUMER's assembly-qualified type names, never the library's, so the namespace has no
      bearing on stored bytes, and none of the 16 golden fixtures reference this assembly.
      Internal machinery lives in DuraIT.FastBinaryJson.Internal, under Internal/ so that
      namespace follows folder.
    -->
    <RootNamespace>DuraIT.FastBinaryJson</RootNamespace>

    <Authors>Ben de Bruijn</Authors>
    <Company>Durable IT Solutions</Company>
    <Copyright>© 2010-2019 Mehdi Gholam, © 2026 Durable IT Solutions</Copyright>
    <Description>Binary JSON serializer for .NET with attribute-free runtime polymorphism. Maintained fork of mgholam/fastBinaryJSON, wire-format compatible with it.</Description>
    <PackageTags>json;binary;serialization;serializer;polymorphic;fastbinaryjson</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Dura-IT/fastbinaryjson</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Dura-IT/fastbinaryjson</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/packages/</PackageOutputPath>
  </PropertyGroup>

  <!--
    README.md is packed so nuget.org shows it. It is plain Markdown with absolute links on
    purpose: nuget.org escapes raw HTML and does not resolve relative links.
  -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    Strong-name signing, for consumers that are themselves strong-named (a .NET Framework application
    cannot reference an unsigned assembly from a signed one). The key pair is a secret and never lives in
    the repository: the release workflow writes it to a temporary file and passes its path in
    StrongNameKeyFile. Ordinary and CI builds are unsigned.

    The unit tests reach internals through InternalsVisibleTo, which needs a signed friend to be named with its
    public key,
    so the signed build omits it, tests always run against the unsigned build, and the release pack signs the same sources afterwards.
  -->
  <PropertyGroup Condition="'$(StrongNameKeyFile)' != ''">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(StrongNameKeyFile)</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- Left out of a signed build: a signed assembly may only name a signed friend with its public key. -->
  <ItemGroup Condition="'$(StrongNameKeyFile)' == ''">
    <InternalsVisibleTo Include="$(MSBuildProjectName).UnitTests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
</Project>
